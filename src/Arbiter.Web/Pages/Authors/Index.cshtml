@page
@model Arbiter.Web.Pages.Authorss.IndexModel

<h1>Authors</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Author</a>
</p>

<table class="table table-striped">

    <thead>

        <tr>

            <th>Full Name</th>

            <th>Email</th>

            <th>Affiliation</th>
            

        </tr>

    </thead>

    <tbody>

    @foreach (var item in Model.Authors)
{
    <tr>

        <td>
            @item.FullName
        </td>

        <td>
            @item.Email
        </td>

        <td>
            @item.Affiliation
        </td>

        <td>
                <a asp-page="Edit"
                    asp-route-id="@item.Id"
                    class="btn btn-sm btn-warning">
                    Edit
                </a>

                <a asp-page="Delete"
                    asp-route-id="@item.Id"
                    class="btn btn-sm btn-danger">
                    Delete
                </a>
            </td>

    </tr>
}

    </tbody>

</table>
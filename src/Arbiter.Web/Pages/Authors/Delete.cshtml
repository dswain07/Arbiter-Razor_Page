@page "{id:int}"
@model Arbiter.Web.Pages.Authors.DeleteModel

<h1>Delete Author</h1>

<h4>Are you sure you want to delete this author?</h4>

<hr />

<p>
    <strong>Name:</strong> @Model.Author.FullName
</p>

<p>
    <strong>Email:</strong> @Model.Author.Email
</p>

<form method="post">

    <input type="hidden" asp-for="Author.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index"
        class="btn btn-secondary">
        Cancel
    </a>

</form>
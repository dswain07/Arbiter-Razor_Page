@page "{id:int}"
@model Arbiter.Web.Pages.Papers.EditModel

<h1>Edit Paper</h1>

<form method="post">

    <input type="hidden" asp-for="Paper.Id" />

    <div class="mb-3">
        <label asp-for="Paper.Title"></label>
        <input asp-for="Paper.Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Paper.Abstract"></label>
        <textarea asp-for="Paper.Abstract" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Paper.Keywords"></label>
        <input asp-for="Paper.Keywords" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Paper.Status"></label>
        <input asp-for="Paper.Status" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Paper.TrackId"></label>
        <input asp-for="Paper.TrackId" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
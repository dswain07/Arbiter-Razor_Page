
@page "{id:int}"
@model Arbiter.Web.Pages.Papers.DeleteModel

@{
    ViewData["Title"] = "Delete Paper";
}

<h1>Delete Paper</h1>

<h4>Are you sure you want to delete this paper?</h4>

<hr />

<div asp-validation-summary="ModelOnly"
        class="text-danger"></div>

<table class="table table-bordered">
    <tr>
        <th>Title</th>
        <td>@Model.Paper?.Title</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Paper?.Status</td>
    </tr>

    <tr>
        <th>Track</th>
        <td>@Model.Paper?.Track?.Name</td>
    </tr>

    <tr>
        <th>Submission Date</th>
        <td>@Model.Paper?.SubmissionDate.ToShortDateString()</td>
    </tr>
</table>

<form method="post">

    <button type="submit"
            class="btn btn-danger">
        Delete Paper
    </button>

    <a asp-page="Index"
        class="btn btn-secondary">
        Cancel
    </a>

</form>

@page "{id:int}"
@model Arbiter.Web.Pages.Papers.DeleteModel

<h1>Delete Paper</h1>

<h4>Are you sure you want to delete this paper?</h4>

<hr />

<p>
    <strong>@Model.Paper.Title</strong>
</p>

<form method="post">

    <input type="hidden" asp-for="Paper.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index"
        class="btn btn-secondary">
        Cancel
    </a>

</form>
@page "{id:int}"
@model Arbiter.Web.Pages.Papers.DetailsModel

<h1>Paper Details</h1>

<table class="table">

    <tr>
        <th>Title</th>
        <td>@Model.Paper?.Title</td>
    </tr>

    <tr>
        <th>Abstract</th>
        <td>@Model.Paper?.Abstract</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Paper?.Status</td>
    </tr>

    <tr>
        <th>Track</th>
        <td>@Model.Paper?.Track?.Name</td>
    </tr>

</table>

<a asp-page="Index" class="btn btn-secondary">
    Back
</a>
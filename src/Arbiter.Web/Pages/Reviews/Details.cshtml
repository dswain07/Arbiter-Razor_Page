
@page "{id:int}"
@model Arbiter.Web.Pages.Reviews.DetailsModel

@{
    ViewData["Title"] = "Review Details";
}

<h1>Review Details</h1>

<table class="table table-bordered">

    <tr>
        <th>Review ID</th>
        <td>@Model.Review?.Id</td>
    </tr>

    <tr>
        <th>Paper</th>
        <td>@Model.Review?.Paper?.Title</td>
    </tr>

    <tr>
        <th>Reviewer Name</th>
        <td>@Model.Review?.ReviewerName</td>
    </tr>

    <tr>
        <th>Score</th>
        <td>@Model.Review?.Score</td>
    </tr>

    <tr>
        <th>Comments</th>
        <td>@Model.Review?.Comments</td>
    </tr>

    <tr>
        <th>Review Date</th>
        <td>@Model.Review?.ReviewDate.ToShortDateString()</td>
    </tr>

</table>

<a asp-page="Edit"
    asp-route-id="@Model.Review?.Id"
    class="btn btn-warning">
    Edit
</a>

<a asp-page="Index"
    class="btn btn-secondary">
    Back
</a>

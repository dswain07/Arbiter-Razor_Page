@page "{id:int}"
@model Arbiter.Web.Pages.Reviews.DeleteModel

<h1>Delete Review</h1>

<h4>Are you sure you want to delete this review?</h4>

<hr />

<p>
    <strong>Name:</strong> @Model.Review.ReviewerName
</p>

<p>
    <strong>Email:</strong> @Model.Review.Score
</p>

<form method="post">

    <input type="hidden" asp-for="Review.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-page="Index"
        class="btn btn-secondary">
        Cancel
    </a>

</form>

@page "{id:int}"
@model Arbiter.Web.Pages.Reviews.DeleteModel

@{
    ViewData["Title"] = "Delete Review";
}

<h1>Delete Review</h1>

<h4>Are you sure you want to delete this review?</h4>

<hr />

<table class="table table-bordered">

    <tr>
        <th>Paper</th>
        <td>@Model.Review.Paper?.Title</td>
    </tr>

    <tr>
        <th>Reviewer Name</th>
        <td>@Model.Review.ReviewerName</td>
    </tr>

    <tr>
        <th>Score</th>
        <td>@Model.Review.Score</td>
    </tr>

    <tr>
        <th>Comments</th>
        <td>@Model.Review.Comments</td>
    </tr>

    <tr>
        <th>Review Date</th>
        <td>@Model.Review.ReviewDate.ToShortDateString()</td>
    </tr>

</table>

<form method="post">

    <input type="hidden" asp-for="Review.Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete Review
    </button>

    <a asp-page="Index"
        class="btn btn-secondary">
        Cancel
    </a>

</form>

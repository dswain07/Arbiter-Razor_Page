
@page
@model Arbiter.Web.Pages.Admin.Tracks.IndexModel

@{
    ViewData["Title"] = "Track Administration";
}

<h1>Track Administration</h1>

<p class="text-muted">
    Manage conference research tracks and submission quotas.
</p>

<p>
    <a asp-page="Create"
        class="btn btn-primary">
        Create New Track
    </a>
</p>

<div class="table-responsive">

    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Track ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Maximum Quota</th>
                <th>Assigned Papers</th>
                <th>Available Slots</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.Tracks)
            {
                <tr>
                    <td>@item.Id</td>

                    <td class="text-nowrap">
                        @item.Name
                    </td>

                    <td>@item.Description</td>

                    <td>@item.MaxQuota</td>

                    <td>@item.Papers.Count</td>

                    <td>
                        @(item.MaxQuota - item.Papers.Count)
                    </td>

                    <td>
                        <div class="d-flex flex-nowrap gap-1">

                            <a asp-page="Edit"
                                asp-route-id="@item.Id"
                                class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-page="Delete"
                                asp-route-id="@item.Id"
                                class="btn btn-sm btn-danger">
                                Delete
                            </a>

                        </div>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>
